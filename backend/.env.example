# =============================================================================
# UniConnect backend environment example
# Copy to .env (or configure these in your hosting dashboard).
# Never commit real secrets.
# =============================================================================

# --- Database (production / MySQL) ------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uniconnect
DB_USERNAME=uniconnect
DB_PASSWORD=change-me
DB_USE_SSL=false
DB_POOL_SIZE=10

# --- JWT --------------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File storage -----------------------------------------------------------
# local (default) stores files under UPLOAD_DIR. s3 uses any S3-compatible API.
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Only needed when STORAGE_TYPE=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_PREFIX=uniconnect

# --- Initial administrator (optional) ---------------------------------------
# Created once on startup only when both ADMIN_EMAIL and ADMIN_PASSWORD are set.
# Password must satisfy the same policy as normal registration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=UniConnect Administrator
ADMIN_UNIVERSITY_ID=ADMIN-001
ADMIN_DEPARTMENT=Administration

# --- Server -----------------------------------------------------------------
PORT=8080
FRONTEND_URL=http://localhost:5173
