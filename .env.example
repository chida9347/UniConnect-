# =============================================================================
# UniConnect Docker Compose environment example
# Copy to .env before running: docker compose up --build
# Never commit real secrets.
# =============================================================================

DB_NAME=uniconnect
DB_USERNAME=uniconnect
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# CORS origin of the frontend container
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional initial administrator (leave blank to skip creation)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=UniConnect Administrator
ADMIN_UNIVERSITY_ID=ADMIN-001
ADMIN_DEPARTMENT=Administration
